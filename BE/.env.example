# คัดลอกเป็น .env แล้วเติมค่าจริง (ห้าม commit ไฟล์ .env)
PORT=5000
NODE_ENV=development
# โดเมนหน้าเว็บที่อนุญาต (CORS) คั่นด้วยจุลภาค ห้ามมี / ท้ายโดเมน
# ตัวอย่าง production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5170
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAIL_DOMAIN=bumail.net
# บน Render/Railway (อยู่หลัง proxy) ตั้งเป็น 1 เพื่อให้ rate limit เห็น IP ผู้ใช้จริง; เครื่องตัวเองเว้นว่าง
TRUST_PROXY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
