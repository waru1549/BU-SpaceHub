erDiagram

    %% ==========================================
    %% RELATIONSHIP MAPPING
    %% ==========================================

    USER_ROLES ||--o{ USERS : assigns

    RESOURCE_CATEGORIES ||--o{ PRINTER_MODELS : categorizes
    PRINTER_MODELS ||--o{ RESOURCES : provides

    RESOURCE_STATUS ||--o{ RESOURCES : defines

    RESOURCES ||--o{ PRINTER_SCHEDULES : has
    SCHEDULE_STATUS ||--o{ PRINTER_SCHEDULES : defines

    USERS ||--o{ PRINTER_BOOKINGS : creates

    PRINTER_SCHEDULES ||--o| PRINTER_BOOKINGS : receives

    BOOKING_STATUS ||--o{ PRINTER_BOOKINGS : defines

    PRINTER_BOOKINGS ||--o{ PRINTER_BOOKING_HISTORY : records

    BOOKING_ACTIONS ||--o{ PRINTER_BOOKING_HISTORY : describes


    %% ==========================================
    %% SHARED TABLES
    %% ==========================================

    USER_ROLES {
        SMALLINT role_id PK
        VARCHAR_20 role_name
    }

    USERS {
        BIGINT user_id PK
        VARCHAR_30 user_code UK
        VARCHAR_255 google_id UK
        VARCHAR_20 university_id
        VARCHAR_255 full_name
        VARCHAR_255 email UK
        VARCHAR_20 phone
        TEXT password_hash
        SMALLINT role_id FK
        VARCHAR_20 user_status
        TIMESTAMP created_at
        TIMESTAMP last_login
    }

    RESOURCE_CATEGORIES {
        SMALLINT type_id PK
        VARCHAR_100 type_name UK
    }

    RESOURCE_STATUS {
        SMALLINT resource_status_id PK
        VARCHAR_50 resource_status_name UK
    }

    RESOURCES {
        BIGINT resource_id PK
        VARCHAR_50 printer_code UK
        BIGINT model_id FK
        VARCHAR_255 location
        INTEGER capacity
        SMALLINT resource_status_id FK
        TIMESTAMP created_at
    }

    SCHEDULE_STATUS {
        SMALLINT schedule_status_id PK
        VARCHAR_50 schedule_status_name UK
    }

    BOOKING_STATUS {
        SMALLINT booking_status_id PK
        VARCHAR_50 booking_status_name UK
    }

    BOOKING_ACTIONS {
        SMALLINT action_id PK
        VARCHAR_100 action_name UK
    }

    %% ==========================================
    %% SUPPORTING ENTITY
    %% ==========================================

    PRINTER_MODELS {
        BIGINT model_id PK
        VARCHAR_255 model_name
        SMALLINT type_id FK
        VARCHAR_255 manufacturer
        TEXT specification
    }

    %% ==========================================
    %% 3D PRINTER BOOKING MODULE TABLES
    %% ==========================================

    PRINTER_SCHEDULES {
        BIGINT schedule_id PK
        BIGINT resource_id FK
        DATE work_date
        TIME start_time
        TIME end_time
        INTEGER max_slots
        SMALLINT schedule_status_id FK
        TIMESTAMP created_at
    }

    PRINTER_BOOKINGS {
        BIGINT booking_id PK
        VARCHAR_50 booking_code UK
        BIGINT user_id FK
        BIGINT schedule_id FK
        TIMESTAMP booking_time
        SMALLINT booking_status_id FK
        TEXT print_purpose
    }

    PRINTER_BOOKING_HISTORY {
        BIGINT history_id PK
        BIGINT booking_id FK
        SMALLINT action_id FK
        TIMESTAMP action_date
    }